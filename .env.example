# Copie para .env (NUNCA commite o .env) e preencha.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
LLM_PROVIDER=groq       # ordem da cadeia padrão: groq (padrão) ou gemini. Gemini gratuito: só 20 req/DIA por modelo
# Cadeias de fallback (opcional): o 1º responde, se falhar o 2º assume, etc. Formato provedor:modelo
# LLM_CADEIA_ESPECIALISTA=groq:openai/gpt-oss-120b,gemini:gemini-3.6-flash,groq:llama-3.3-70b-versatile
# LLM_CADEIA_RAPIDO=groq:openai/gpt-oss-20b,groq:llama-3.1-8b-instant,gemini:gemini-3.6-flash

# Postgres das tools de produto/ingrediente/rotina (docker compose up -d)
DATABASE_URL=postgresql://venus:venus@localhost:5432/venus

# Opcionais
MONGODB_URI=            # checkpointer/store persistentes (extra `mongo`)
TAVILY_API_KEY=         # busca web; sem ela usa DuckDuckGo
FAQ_DIR=                # padrão: data/faq
MCP_SERVERS=            # JSON {"nome": {"transport": ..., ...}}; padrão: servidor MCP do próprio Venus
A2A_AGENTES_EXTERNOS=   # JSON {"nome": "http://host:porta"}
